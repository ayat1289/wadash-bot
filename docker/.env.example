# Production secrets for the deployment (one value per line).
# This file is gitignored — it is written on the host by the deploy scripts
# from repository secrets. Do NOT commit real values.

POSTGRES_USER=wadash
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wadash
DATABASE_URL=postgresql://wadash:change-me@db:5432/wadash
TELEGRAM_BOT_TOKEN=
TELEGRAM_FORCE_JOIN_CHAT=@CyropesTriks
# YouTube is IP-blocked from this host ("Sign in to confirm you're not a bot"
# for every player client). The ONLY bypass is a browser cookie session. To
# enable YouTube downloads, export your YouTube cookies as a Netscape cookies.txt
# (e.g. the "Get cookies.txt LOCALLY" extension), save it at ./cookies.txt
# (already bind-mounted into the container at /app/cookies.txt), and uncomment:
#YOUTUBE_COOKIES_FILE=/app/cookies.txt
# While set, name-search and video-by-name switch to YouTube; otherwise they use
# SoundCloud (not blocked). Refresh the cookies if the bot hits the "bot check"
# again. Leave commented out to keep using SoundCloud only.
# Instagram is also IP-blocked from this host (yt-dlp gets an empty media
# response). The only supported bypass is the hosted SenatorAPI downloader:
# get a free API key from @Api_ManagerRoBot (see docs.fast-creat.ir) and set:
#INSTAGRAM_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_INTEGRATIONS_GEMINI_API_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
LOG_LEVEL=info